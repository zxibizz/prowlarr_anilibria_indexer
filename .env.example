# Copy to .env and edit as needed. `docker compose` reads this file automatically.

# Where the proxy service listens. Published to the host for development; Prowlarr
# reaches it over the compose network as anilibria-proxy:8788.
# PROXY_PORT=8788

# The path the proxy answers itself. Everything else is relayed to the real site.
# Keep this in step with the search path in definitions/anilibria.yml.
# PROXY_DIVERT_PREFIX=/_anilibria_proxy

# How many matched releases to expand into torrents per search, how long a result
# is reused, and how hard to lean on the upstream API.
# PROXY_MAX_RELEASES=10
# PROXY_CACHE_TTL=300
# PROXY_REQUEST_DELAY=0.2

# --- Where Prowlarr looks for the proxy ---------------------------------------
# Not set here. That is the host and port of Prowlarr's "Http" indexer proxy,
# configured either in Settings -> Indexer Proxies or with:
#
#   python3 scripts/configure_proxy.py anilibria-proxy:8788
#
# Prowlarr validates the address when it saves, so a wrong one is rejected with
# "Connection refused (host:port)" instead of failing silently later.
